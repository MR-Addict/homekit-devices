+package remote
+
+import (
+	"io"
+	"log/slog"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	pb "github.com/jkiddo/atvremote/pkg/v2/proto"
+)
+
+type deadlineConn struct {
+	net.Conn
+	writes atomic.Int32
+}
+
+func (c *deadlineConn) SetWriteDeadline(t time.Time) error {
+	if !t.IsZero() {
+		c.writes.Add(1)
+		t = time.Now().Add(20 * time.Millisecond)
+	}
+	return c.Conn.SetWriteDeadline(t)
+}
+func TestWriteDeadlineBoundsBlockedFrame(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	wrapped := &deadlineConn{Conn: a}
+	c := newProtobufConn(wrapped)
+	began := time.Now()
+	if err := c.sendMessage(&pb.RemoteMessage{RemotePingResponse: &pb.RemotePingResponse{}}); err == nil {
+		t.Fatal("blocked write succeeded")
+	}
+	if wrapped.writes.Load() != 1 || time.Since(began) > time.Second {
+		t.Fatal("write deadline missing")
+	}
+}
+func TestOutboundFramesDoNotResetInboundWatchdog(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	p := newRemoteProtocol(newProtobufConn(a), slog.New(slog.NewTextHandler(io.Discard, nil)), false, false, func(bool) {}, func(string) {}, func(VolumeInfo) {})
+	defer p.close()
+	p.idleTimer.Reset(40 * time.Millisecond)
+	done := make(chan struct{})
+	go func() { defer close(done); newProtobufConn(b).readRaw() }()
+	if err := p.send(&pb.RemoteMessage{RemotePingResponse: &pb.RemotePingResponse{}}, false); err != nil {
+		t.Fatal(err)
+	}
+	<-done
+	select {
+	case <-p.conLost:
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("outbound traffic hid missing inbound traffic")
+	}
+	r := &AndroidTVRemote{proto: p}
+	if _, known := r.IsOn(); known {
+		t.Fatal("closed power treated as known")
+	}
+	if _, known := r.CurrentApp(); known {
+		t.Fatal("closed app treated as known")
+	}
+	if r.VolumeInfo() != nil || r.DeviceInfo() != nil {
+		t.Fatal("closed metadata retained")
+	}
+	select {
+	case <-r.ConnectionDone():
+	default:
+		t.Fatal("connection loss not exposed")
+	}
+}
