+package remote
+
+// Features reports the negotiated features of the current connection.
+func (r *AndroidTVRemote) Features() (Feature, bool) {
+ p := r.protocol()
+ if p == nil || p.closed() { return 0, false }
+ return p.features(), true
+}
+
+// IMEReady reports whether this connection has received input-field counters.
+func (r *AndroidTVRemote) IMEReady() bool {
+ p := r.protocol()
+ if p == nil || p.closed() { return false }
+ p.mu.Lock()
+ defer p.mu.Unlock()
+ return p.imeReady && p.activeFeatures & FeatureIME != 0
+}
