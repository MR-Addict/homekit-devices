#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/homekit-wol
CONFIG=/etc/homekit-wol/config.yaml

start_service() {
    [ -x "$PROG" ] || return 1
    [ -r "$CONFIG" ] || return 1
    procd_open_instance
    procd_set_param command "$PROG" -config "$CONFIG"
    procd_set_param file "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# rc.common reload re-submits the instance; procd watches CONFIG and
# replaces the process after it has stopped when the file changes.
